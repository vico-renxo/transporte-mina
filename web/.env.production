# La API va por Cloudflare desde el 2026-08-30: viczul.com/api/* lo atiende
# el Worker 'transporte-api' y de ahi pasa a Render. Asi el WAF, el rate
# limiting del borde y las analiticas SI ven el trafico de la API.
NEXT_PUBLIC_API_URL=https://viczul.com

# El WebSocket NO: Socket.io hace polling + upgrade y meterlo detras del
# proxy es un riesgo que no hace falta correr. Va derecho a Render, y la
# ruta del Worker (solo /api/*) ni lo toca.
NEXT_PUBLIC_SOCKET_URL=https://transporte-mina.onrender.com
